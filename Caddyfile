# Reverse proxy for prod and preprod. DOMAIN is set in the compose file.
# Caddy obtains and renews the Let's Encrypt certificate automatically
# and redirects HTTP to HTTPS.
{$DOMAIN:localhost} {
	# Serve static files from Django
	handle_path /static/* {
		root * /staticfiles # This path must match where you mount your staticfiles
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Board images uploaded by users. Untrusted content (SVG may embed scripts),
	# hence the sandbox CSP and nosniff.
	handle_path /media/* {
		root * /media
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		file_server
	}

	# For pgadmin (served under /pgadmin via SCRIPT_NAME)
	handle /pgadmin* {
		reverse_proxy pgadmin:80
	}

	# For the Django backend (API, admin and board WebSockets)
	@backend path /api/* /admin/* /ws/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# For the frontend
	handle {
		reverse_proxy frontend:80
	}
}
