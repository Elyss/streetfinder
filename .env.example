# ------------------------------------------------------------------
# Template des variables d'environnement du projet.
#
# Ce fichier est volontairement INACTIF : toutes les lignes sont
# commentées, donc il ne doit PAS etre utilise tel quel.
#
# Usage :
#   1. Copier ce fichier en ".env" (a la racine du projet)
#   2. Decommenter chaque ligne et renseigner une vraie valeur
#   3. Ne jamais committer le fichier ".env" (deja ignore par .gitignore)
# ------------------------------------------------------------------

# --- Base de donnees (service "db" + backend Django) ---------------
# Utilise a la fois par le service postgres et par backend/config/settings.py
# POSTGRES_DB=streetfinder
# POSTGRES_USER=streetfinder
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Django backend --------------------------------------------------
# DEBUG=True
# Obligatoire en preprod/prod (une valeur de dev est utilisee par defaut)
# SECRET_KEY=
# valeurs multiples separees par des virgules, ex: exemple.com,www.exemple.com
# ALLOWED_HOSTS=
# URL du frontend (origine autorisee par CORS)
# FRONTEND_URL=http://localhost:5174
# Channel layer of the real-time boards (set by the compose files).
# Sans valeur : couche en memoire, valable pour un seul processus.
# REDIS_URL=redis://redis:6379/0

# --- E-mails (comptes : invitation, mot de passe oublié, activation) --
# Mailer Django (SMTP). En dev, le backend "console" affiche les e-mails
# dans les logs du backend au lieu de les envoyer.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL="Delay Lama <noreply@elyss.fr>"  (guillemets requis : run.sh charge ce fichier avec bash)

# --- pgAdmin (service "pgadmin") ------------------------------------
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=change-me

# --- Docker Hub (utilise uniquement par run.sh push/pull) ----------
# DOCKER_USERNAME=
# DOCKER_PASSWORD=
